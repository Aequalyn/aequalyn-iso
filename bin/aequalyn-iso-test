#!/usr/bin/env bash
# test-iso.sh -- boot a Aequalyn ISO in QEMU (UEFI via OVMF) so you can try the
# live desktop and the installer without rebooting the host.
#
#   ./bin/aequalyn-iso-test                       uses the newest Aequalyn ISO
#   ./bin/aequalyn-iso-test path/to/aequalyn.iso
#   RAM=8192 CPUS=6 ./bin/aequalyn-iso-test
#
# The VM window is a GTK window on the host desktop. Close it (or Ctrl+C in the
# terminal) to stop. The ISO is attached read-only, so nothing is written to it.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ISO=${1:-$(ls -1t "$HERE"/../release/*.iso 2>/dev/null | head -1 || true)}
[[ -n "$ISO" && -f "$ISO" ]] || { echo "No Aequalyn ISO found. Build one with: sudo ./bin/aequalyn-iso-make" >&2; exit 1; }

OVMF_CODE=/usr/share/edk2/x64/OVMF_CODE.4m.fd
OVMF_VARS=/usr/share/edk2/x64/OVMF_VARS.4m.fd
[[ -f "$OVMF_CODE" && -f "$OVMF_VARS" ]] || {
    echo "OVMF firmware missing. Install with: sudo pacman -S edk2-ovmf" >&2
    exit 1
}

RAM=${RAM:-4096}
CPUS=${CPUS:-4}
VARS=$(mktemp /tmp/aequalyn-ovmf-vars-XXXXXX.fd)
cp "$OVMF_VARS" "$VARS"
trap 'rm -f "$VARS"' EXIT

echo "Booting: $ISO"
echo "  RAM ${RAM} MiB, ${CPUS} CPUs, UEFI (OVMF), virtio-gpu"
echo "  Close the QEMU window or press Ctrl+C here to stop."

exec qemu-system-x86_64 \
    -name "Aequalyn live" \
    -enable-kvm \
    -m "$RAM" -smp "$CPUS" \
    -cpu host \
    -drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
    -drive if=pflash,format=raw,file="$VARS" \
    -cdrom "$ISO" \
    -boot d \
    -device virtio-gpu-pci \
    -display gtk \
    -device virtio-net-pci,netdev=aequalyn-net \
    -netdev user,id=aequalyn-net \
    -usb -device usb-tablet
