#!/usr/bin/env bash
# Aequalyn live session launcher (tty1 autologin for the `live` user).
# If Hyprland cannot start (e.g. no GPU / headless VM), drop to a shell so the
# installer and rescue tools remain reachable.
set -u

if [[ "$(tty 2>/dev/null)" != "/dev/tty1" ]]; then
    exec /bin/bash
fi

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH="$HOME/.local/bin:$PATH"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Hyprland wants to be started through start-hyprland (0.57+); older builds
# only have the Hyprland binary.
launch() {
    if command -v start-hyprland >/dev/null 2>&1; then dbus-run-session -- start-hyprland
    else dbus-run-session -- Hyprland; fi
}

if command -v Hyprland >/dev/null 2>&1; then
    printf '\n\033[38;5;212mWelcome to Aequalyn\033[0m -- starting the desktop...\n'
    started=$SECONDS
    launch
    # Gone within seconds: no usable GPU (a VM without 3D acceleration, say).
    # Try once more with software rendering, which is slow but works everywhere.
    if (( SECONDS - started < 15 )); then
        printf '\n\033[1;33mThe desktop did not start with the GPU; trying software rendering...\033[0m\n'
        started=$SECONDS
        LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe launch
        # Some virtual GPUs (VirtualBox VMSVGA) reject atomic modesetting.
        if (( SECONDS - started < 15 )); then
            printf '\n\033[1;33mStill no desktop; trying without atomic modesetting...\033[0m\n'
            AQ_NO_ATOMIC=1 LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe launch
        fi
    fi
    printf '\n\033[1;33mHyprland exited.\033[0m\n'
fi

printf '\033[1;33mAequalyn desktop unavailable.\033[0m Dropping to a shell.\n'
printf 'Run \033[1msudo aequalyn-install\033[0m to install, or \033[1msudo aequalyn-repair\033[0m to fix a system.\n\n'
exec /bin/bash
